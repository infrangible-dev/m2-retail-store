use Infrangible\RetailStore\Block\Widget\GoogleMaps\Search;
use Magento\Framework\Escaper;

/** @var Search $block */
/** @var Escaper $escaper */

$maxDistance = $block->getMaxDistanceValue();
?>
<form name="retail-store-search" id="retail-store-search" action="<?= $escaper->escapeUrl($block->getSearchUrl()) ?>"
      method="get">
    <div class="retail-store-search-bar">
        <input name="result_block_id" type="hidden" value="<?= /* @noEscape */ $block->getResultBlockId() ?>">
        <input name="no_result_block_id" type="hidden" value="<?= /* @noEscape */ $block->getNoResultBlockId() ?>">

        <div class="location">
            <?= /* @noEscape */ $block->getLocationInput() ?>
        </div>

        <div class="radius">
            <label for="max_distance"><?= $escaper->escapeHtml(__('Radius')) ?>:</label>
            <select id="max_distance" name="max_distance">
                <?php foreach ($block->getDistances() as $distance => $label): ?>
                    <option value="<?= /* @noEscape */ $distance ?>"
                        <?= $distance === $maxDistance ? 'selected' : '' ?>>
                        <?= $escaper->escapeHtml($label) ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>

        <div class="buttons">
            <?= /* @noEscape */ $block->getButtonsHtml() ?>
        </div>
    </div>
</form>
<!--suppress JSUnresolvedVariable, JSUnresolvedFunction -->
<script>
    document.addEventListener("google-maps-api", function () {
        const locationButton = document.getElementById("determine-location");

        if (!locationButton) {
            return;
        }

        locationButton.addEventListener("click", () => {
            if (!navigator.geolocation) {
                window.alert("<?= $escaper->escapeJs(__('Your browser cannot determine your location.')) ?>");

                return;
            }

            navigator.geolocation.getCurrentPosition(
                (position) => {
                    const location = {
                        lat: position.coords.latitude,
                        lng: position.coords.longitude
                    };

                    new google.maps.Geocoder().geocode({location: location}).then((response) => {
                        if (response.results[0]) {
                            document.getElementById("location").value = response.results[0].formatted_address;
                        } else {
                            window.alert("<?= $escaper->escapeJs(__('No address was found for your location.')) ?>");
                        }
                    }).catch(() => {
                        window.alert("<?= $escaper->escapeJs(__('Your location could not be determined.')) ?>");
                    });
                },
                () => {
                    window.alert("<?= $escaper->escapeJs(__('Your location could not be determined.')) ?>");
                }
            );
        });
    });
</script>

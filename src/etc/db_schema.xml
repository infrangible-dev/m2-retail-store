        </index>
    </table>
    <table name="retail_store_feature" resource="default" engine="innodb" comment="Retail Store Feature">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name"/>
        <column xsi:type="text" name="image" nullable="false" comment="Image"/>
        <column xsi:type="smallint" name="status" padding="6" unsigned="false" nullable="true" identity="false" comment="Status"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
    </table>
    <table name="quote">
        <column xsi:type="int" name="retail_store_id" padding="10" unsigned="true" nullable="true" identity="false" comment="Entity Id of Retail Store"/>
        <constraint xsi:type="foreign" referenceId="QUOTE_RETAIL_STORE_ID_RETAIL_STORE_ENTITY_ENTITY_ID" table="quote" column="retail_store_id" referenceTable="retail_store_entity" referenceColumn="entity_id" onDelete="SET NULL"/>
    </table>
    <table name="sales_order">
        <column xsi:type="int" name="retail_store_id" padding="10" unsigned="true" nullable="true" identity="false" comment="Entity Id of Retail Store"/>
        <constraint xsi:type="foreign" referenceId="SALES_ORDER_RETAIL_STORE_ID_RETAIL_STORE_ENTITY_ENTITY_ID" table="sales_order" column="retail_store_id" referenceTable="retail_store_entity" referenceColumn="entity_id" onDelete="SET NULL"/>

<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="retail_store_entity" resource="default" engine="innodb" comment="Retail Store">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="datetime" name="created_at" on_update="false" nullable="false" comment="Creation Time"/>
        <column xsi:type="datetime" name="updated_at" on_update="false" nullable="false" comment="Update Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>
    <table name="retail_store_entity_datetime" resource="default" engine="innodb" comment="Retail Store Datetime Values">
        <column xsi:type="int" name="value_id" padding="11" unsigned="false" nullable="false" identity="true" comment="Value ID"/>
        <column xsi:type="smallint" name="entity_type_id" padding="5" unsigned="true" nullable="false" identity="false" default="0" comment="Entity Type ID"/>
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="false" default="0" comment="Entity ID"/>
        <column xsi:type="smallint" name="attribute_id" padding="5" unsigned="true" nullable="false" identity="false" default="0" comment="Attribute ID"/>
        <column xsi:type="smallint" name="store_id" padding="5" unsigned="true" nullable="false" identity="false" default="0" comment="Store ID"/>
        <column xsi:type="datetime" name="value" on_update="false" nullable="true" comment="Value"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="value_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="RETAIL_STORE_ENTITY_DATETIME_ENTITY_ID_ATTRIBUTE_ID_STORE_ID">
            <column name="entity_id"/>
            <column name="attribute_id"/>
            <column name="store_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="RETAIL_STORE_ENTITY_DATETIME_ENTITY_ID_RETAIL_STORE_ENTITY_ENTITY_ID" table="retail_store_entity_datetime" column="entity_id" referenceTable="retail_store_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="RETAIL_STORE_ENTITY_DATETIME_ATTRIBUTE_ID_EAV_ATTRIBUTE_ATTRIBUTE_ID" table="retail_store_entity_datetime" column="attribute_id" referenceTable="eav_attribute" referenceColumn="attribute_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="RETAIL_STORE_ENTITY_DATETIME_STORE_ID_STORE_STORE_ID" table="retail_store_entity_datetime" column="store_id" referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
        <index referenceId="RETAIL_STORE_ENTITY_DATETIME_ENTITY_ID" indexType="btree">
            <column name="entity_id"/>
        </index>
        <index referenceId="RETAIL_STORE_ENTITY_DATETIME_ATTRIBUTE_ID" indexType="btree">
            <column name="attribute_id"/>
        </index>
        <index referenceId="RETAIL_STORE_ENTITY_DATETIME_STORE_ID" indexType="btree">
            <column name="store_id"/>
        </index>
    </table>
    <table name="retail_store_entity_decimal" resource="default" engine="innodb" comment="Retail Store Decimal Values">
        <column xsi:type="int" name="value_id" padding="11" unsigned="false" nullable="false" identity="true" comment="Value ID"/>
        <column xsi:type="smallint" name="entity_type_id" padding="5" unsigned="true" nullable="false" identity="false" default="0" comment="Entity Type ID"/>

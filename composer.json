{
    "name": "infrangible/m2-retail-store",
    "description": "Store locator for shops with physical branches: manage retail stores in the admin, show them on Google Maps, let shoppers search for the nearest store and give every store its own page.",
    "type": "magento2-module",
    "version": "2.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Store locator",
        "Content",
        "Hyvä",
        "store locator",
        "store finder with Google Maps",
        "branch pages"
    ],
    "homepage": "https://www.infrangible.dev/modules/retail-store",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "fewedev/base": "~2.4.1",
        "infrangible/m2-backend-widget": "~4.0.4",
        "infrangible/m2-cms-filter": "~2.0.0",
        "infrangible/m2-core": "~5.0.4",
        "infrangible/m2-foundation": "~3.0.1",
        "infrangible/m2-google-maps": "~2.0.0",
        "magento/framework": "~103.0.6",
        "magento/module-backend": "~102.0.0",
        "magento/module-cms": "~104.0.0",
        "magento/module-config": "~101.2.0",
        "magento/module-customer": "~103.0.0",
        "magento/module-eav": "~102.1.0",
        "magento/module-media-storage": "~100.4.0",
        "magento/module-quote": "~101.2.0",
        "magento/module-sales": "~103.0.0",
        "magento/module-store": "~101.1.0",
        "magento/module-theme": "~101.1.0",
        "magento/module-widget": "~101.2.0",
        "psr/log": "~2.0.0||~3.0.0",
        "symfony/console": "~5.4.0||~6.4.0||~7.4.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\RetailStore\\": "src"
        }
    }
}
